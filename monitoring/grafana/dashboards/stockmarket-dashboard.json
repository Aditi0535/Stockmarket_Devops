    {
      "id": 7,
      "title": "Container CPU Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 8,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"$container\",name!=\"\"}[5m])) by (name) * 100",
